{
  "study": "ih-decay-pilot-v0",
  "dataset": {
    "bucket": "hf://buckets/Jaycee766/ih-challenge-bucket",
    "files": [
      "single-constraint.jsonl",
      "multi-constraint.jsonl",
      "input-conditioned.jsonl",
      "anti-overrefusal.jsonl"
    ],
    "items_per_file": 25,
    "selection_seed": 20260905
  },
  "trajectory": {
    "checkpoints": [1, 3, 5, 10, 20],
    "condition": "persistence-only",
    "carry_forward_model_output": true,
    "inject_new_lower_priority_content": false
  },
  "generation": {
    "model": "openai/gpt-oss-20b",
    "temperature": 0.0,
    "max_tokens": 4096,
    "reasoning_effort": "low"
  },
  "step1_baseline": {
    "shards": "one shard per public split",
    "provider_retry_attempts": 4,
    "grader_timeout_seconds": 2.0,
    "grader_memory_mb": 256
  },
  "record": [
    "model",
    "source_file",
    "row_index",
    "selection_seed",
    "checkpoint",
    "output",
    "grader_pass",
    "prompt_tokens",
    "completion_tokens",
    "total_tokens"
  ]
}
